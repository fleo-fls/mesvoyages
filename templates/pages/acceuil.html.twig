{% extends "basefront.html.twig" %}

{% block body %}
<div class="container py-5">

  <!-- TITRE -->
  <div class="text-center mb-4">
    <h1 class="fw-bold">Bienvenue sur mon site de voyages autour du monde</h1>
  </div>

  <!-- TEXTE INTRO -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-4">
      <h5 class="mb-0">
        Dans la partie
        <a class="text-decoration-none fw-bold" href="{{ path('voyages') }}">Voyages</a>,
        tu peux voir la liste des visites que j’ai faites dans différentes villes.
        <br><br>
       Dans cet univers parallèle, où Paris ce situe en chine, tu peux trier la liste des voyages par ville, pays, note et date.
        <br><br>
        En cliquant sur une ville, tu obtiens plus d’informations et une jolie photo.
        <br><br>
        Tu peux aussi me contacter via le formulaire
        <a class="text-decoration-none fw-bold" href="{{ path('contact') }}">Contact</a>.
      </h5>
    </div>
  </div>

  <!-- DERNIÈRES AVENTURES -->
  <div class="card shadow-sm border-0">
    <div class="card-body p-4">
      <h5 class="mb-3">Voici mes deux dernières aventures :</h5>

      <div class="row g-4">
        {% for visite in lastVisites %}
          <div class="col-md-6">
            <a class="text-decoration-none" href="{{ path('voyages.showone', { id: visite.id }) }}">
              <div class="card h-100 shadow-sm border-0">

                {% if visite.imageName %}
                  <img
                    src="{{ asset('images/visites/' ~ visite.imageName) }}"
                    class="card-img-top"
                    alt="Photo {{ visite.ville }}"
                    style="object-fit: cover; height: 220px;"
                  >
                {% endif %}

                <div class="card-body">
                  <h4 class="fw-bold">{{ visite.ville }}</h4>
                  <div class="text-muted">{{ visite.pays }}</div>

                  <div class="mt-2">
                    <span class="badge bg-primary">{{ visite.note }}/20</span>
                    <span class="ms-2 text-muted">{{ visite.dateCreationString }}</span>
                  </div>
                </div>

              </div>
            </a>
          </div>
        {% endfor %}
      </div>

    </div>
  </div>

</div>
{% endblock %}
